[sub_resource type="GDScript" id="GDScript_c68sx"]
script/source = "extends CharacterBody2D
@export var bounciness:=1.0
const speed=350
var hp=100
var damage=20
var side='good'
var grown=false
var egg_path=preload(\"res://scenes/good_egg.tscn\")
var type='good_chick'
@onready var health_bar=$HealthBar
@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D
@onready var flash_animation: AnimationPlayer = $AnimatedSprite2D/FlashAnimation
@onready var grow_timer: Timer = $grow_timer
@onready var audio_stream_player_2d: AudioStreamPlayer2D = $AudioStreamPlayer2D
@onready var stun: Timer = $stun
var moving=true



var started=false
func _ready() -> void:
	health_bar.value=hp
	animated_sprite_2d.play(\"chick\")
	randomize()
	velocity=Vector2.RIGHT.rotated(randf()*TAU)*speed
	grow_timer.start()
	
func _process(delta: float) -> void:
	health_bar.value=hp




func _physics_process(delta: float) -> void:
	var collision=move_and_collide(velocity*delta)
	if collision and moving:
		velocity=velocity.bounce(collision.get_normal())*bounciness
		var collider=collision.get_collider()
		if not (collider is CharacterBody2D) and grown:
			fire()
		
	if hp<=0:
		Global.animals.erase(self)
		queue_free()
	if velocity.x<0:
		animated_sprite_2d.flip_h=true
	else:
		animated_sprite_2d.flip_h=false

func fire():
	var egg = egg_path.instantiate()
	egg.global_position = $CollisionShape2D.global_position
	egg.rotation = global_rotation
	egg.velocity=velocity
	get_parent().add_child(egg)
	audio_stream_player_2d.play()


func _on_grow_timer_timeout() -> void:
	grown=true
	animated_sprite_2d.play(\"chicken\")
	audio_stream_player_2d.play()
"

